# ── Sekrety / środowisko ──────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ── Node / build ──────────────────────────────────────────
node_modules/
dist/
build/
.next/
out/
.turbo/
coverage/
*.tsbuildinfo

# ── Playwright (E2E) ──────────────────────────────────────
test-results/
playwright-report/
playwright/.cache/
blob-report/

# ── Dane lokalne (SQLite, cache, okładki) ─────────────────
data/*.db
data/*.db-*
data/cache/
*.sqlite
*.sqlite3

# ── Dokumentacja (MkDocs) ─────────────────────────────────
site/
# UWAGA: wiodący `/` jest OBOWIĄZKOWY — to wyjście `mkdocs build --site-dir public` w KORZENIU repo.
# Bez kotwicy wzorzec łapie na KAŻDEJ głębokości: `dashboard/public/`, `web/public/` → nowy favicon,
# logo czy obrazek OG jest niewidoczny dla `git add .`, commit wychodzi „czysty", a na Vercelu plik
# daje 404. Śledzone dziś pliki w dashboard/public/ przeżyły tylko dlatego, że git nie ignoruje
# już-śledzonych. NIE odkotwiczaj (zgłoszenie: logo/favicon E-Forge → dashboard/public/ghost-skull.png).
/public/
.venv/
.cache/

# ── Logi ──────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# ── OS / IDE / agent ──────────────────────────────────────
.DS_Store
# AppleDouble: macOS zapisuje resource forki obok plików na woluminach nie-HFS
# (repo bywa trzymane na dysku współdzielonym z Windowsem) — jeden `git checkout`
# potrafi wysypać kilkadziesiąt takich `._*`.
._*
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
# .claude/ — ignoruj lokalne (launch.json, settings.local.json), ale śledź współdzielony settings.json (hook sync docs)
.claude/*
!.claude/settings.json
.vercel/
